{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile record for an authenticated user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "Notebook": {
      "title": "Notebook",
      "description": "A GitHub repository notebook workspace owned by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "repoUrl": { "type": "string", "maxLength": 512 },
        "ref": { "type": "string", "maxLength": 128 },
        "pathFilter": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "indexStatus": { "type": "string", "enum": ["idle", "fetching", "indexing", "ready", "error"], "maxLength": 32 },
        "source": { "type": "object" },
        "files": { "type": "array" },
        "chunks": { "type": "array" },
        "suggestedQuestions": { "type": "array" },
        "pinnedCitations": { "type": "array" }
      },
      "required": ["id", "ownerId", "name", "repoUrl", "ref", "createdAt", "updatedAt", "indexStatus"]
    },
    "Note": {
      "title": "Note",
      "description": "A research note associated with a notebook and owned by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "notebookId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "content": { "type": "string", "maxLength": 65536 },
        "tags": { "type": "array" },
        "citations": { "type": "array" },
        "sourceMessageId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerId", "notebookId", "title", "content", "createdAt", "updatedAt"]
    },
    "Artifact": {
      "title": "Artifact",
      "description": "An AI-generated research artifact (mindmap, architecture, slide deck, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "notebookId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "content": { "type": "string", "maxLength": 131072 },
        "citations": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerId", "notebookId", "type", "title", "content", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A chat message within a repository notebook conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "notebookId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "assistant", "system"], "maxLength": 16 },
        "content": { "type": "string", "maxLength": 65536 },
        "citations": { "type": "array" },
        "suggestedFollowUps": { "type": "array" },
        "answerMode": { "type": "string", "maxLength": 32 },
        "modelUsed": { "type": "string", "maxLength": 64 },
        "confidence": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerId", "notebookId", "role", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection containing account information"
    },
    "/notebooks/{notebookId}": {
      "schema": "Notebook",
      "description": "Repository notebooks collection created by users"
    },
    "/notes/{noteId}": {
      "schema": "Note",
      "description": "User created and saved research notes"
    },
    "/artifacts/{artifactId}": {
      "schema": "Artifact",
      "description": "AI-generated research artifacts for repository notebooks"
    },
    "/chatMessages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Conversational messages with citations and suggested follow-ups"
    }
  }
}
